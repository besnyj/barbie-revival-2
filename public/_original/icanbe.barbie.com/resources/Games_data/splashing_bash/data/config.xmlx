<?xml version="1.0" encoding="utf-8"?>
<data>
	<!-- config block is  universal, all games must have path to data transfer swf and game ID
		 When adding game specific tags, consider distinguishing them
	     from required tags. -->
	<config>
		<gameID>21</gameID>
		<!-- Tracking code for specific events.  DO NOT CHANGE id tags.  All other attributes are editable to
		match tracking content-->
		<tracking>
			<item id="view" name='I Can Be: Swim Instructor Game' campaign='None' channel='I can be' contenttype='Game' action='View' />
			<item id="play" name='I Can Be: Swim Instructor Game' campaign='None' channel='I can be' contenttype='Game' action='Play' />
			<item id="replay" name='I Can Be: Swim Instructor Game' campaign='None' channel='I can be' contenttype='Game' action='Game Replay' />
			<item id="level1" name='I Can Be: Swim n Splash Game - Kiddy Pool' campaign='None' channel='I can be' contenttype='Game' action='Click' />
			<item id="level2" name='I Can Be: Swim n Splash Game - Practice Pool' campaign='None' channel='I can be' contenttype='Game' action='Click' />
			<item id="level3" name='I Can Be: Swim n Splash Game - Super Pool' campaign='None' channel='I can be' contenttype='Game' action='Click' />	
		</tracking>
		
		<!-- controllerSWF will contain the path of the swf used for scoring -->
		<controllerSWF>/Resources/Games_Data/global/swf/gameapi.swf</controllerSWF>
		<contentData>/data/swiminstructor.xmlx</contentData>
		<contentDataMulti parent_folder="/data/">swiminstructor.xmlx</contentDataMulti>
		
		<libraries>
			<item>/library/soundBank.swf</item>
		</libraries>
		
		<audio>
		</audio>
		
		<actions>
			<item id="lock" actionID='89' itemID='224' description='Barbie I Can Be Doll' />
			<item id="award1" actionID='86' itemID='225' description='Game: Swim Instructor 1' />
			<item id="award2" actionID='87' itemID='226' description='Game: Swim Instructor 2' />
			<item id="award3" actionID='88' itemID='227' description='Game: Swim Instructor 3' />
		</actions>
	
	</config>

	
	
</data>