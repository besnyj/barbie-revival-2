<?xml version="1.0" encoding="utf-8"?>
<data>
	<!-- config block is  universal, all games must have path to data transfer swf and game ID
		 When adding game specific tags, consider distinguishing them
	     from required tags. -->
	<config>
		<gameID>7</gameID>
		<gameTrackingName><![CDATA[I Can Be: Potty Race Game]]></gameTrackingName>
		<!-- controllerSWF will contain the path of the swf used for scoring -->
		<tracking>
			<item id="view" name='I Can Be: Potty Race Game' campaign='None' channel='I can be' contenttype='Game' action='View' />
			<item id="play" name='I Can Be: Potty Race Game' campaign='None' channel='I can be' contenttype='Game' action='Play' />
			<item id="floor1" name='I Can Be: Potty Race Game - 1st Floor' campaign='None' channel='I can be' contenttype='Game' action='Click' />
			<item id="floor2" name='I Can Be: Potty Race Game - 2nd Floor' campaign='None' channel='I can be' contenttype='Game' action='Click' />
			<item id="floor3" name='I Can Be: Potty Race Game - 3rd Floor' campaign='None' channel='I can be' contenttype='Game' action='Click' />
			<item id="replay" name='I Can Be: Potty Race Game' campaign='None' channel='I can be' contenttype='Game' action='Game Replay' />
		</tracking>
		<controllerSWF>/Resources/Games_Data/global/swf/gameapi.swf</controllerSWF>
		<contentData>/data/babysitter.xmlx</contentData>
		<contentDataMulti parent_folder="/data/">babysitter.xmlx</contentDataMulti>
		<gameKey>babysitter</gameKey>
				
		<libraries>
			<item>/library/soundBank.swf</item>
		</libraries>
		
		<audio>
		<!--
			<item id="vo1" src="audio/vo/001SuperWhyTk02.mp3" />
			<item id="vo2" src="audio/vo/002SuperWhyTk02.mp3" />
			<item id="vo3" src="audio/vo/03SuperWhyTk01.mp3" />
			<item id="vo4" src="audio/vo/003SuperWhyTk08.mp3" />
			-->
		</audio>
		
		<actions>
			<item id="lock" actionID='0'  itemID='15' description='Barbie I Can Be Babysitter Doll' />
			<item id="bonus" actionID='9' itemID='73' description='Game: Babysitter bonus pickup' />
			<item id="win" actionID='10' itemID='74' description='Game: Babysitter win' />
		</actions>

		<codeUnlockURL>change/configxml/codeUnlockURL/placeholder.html</codeUnlockURL>
		
	</config>

</data>