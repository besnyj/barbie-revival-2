<?xml version="1.0" encoding="utf-8"?>
<data>
	<styleSheet>/styles/latin.css</styleSheet>
	<fontSwf>/library/fontLibrary_latin.swf</fontSwf>
	<locked>false</locked>	

	<localization>
		
		<txt_logo_Race><![CDATA[Race]]></txt_logo_Race>
		<txt_logo_Potty><![CDATA[POTTY]]></txt_logo_Potty>
		<txt_game_Score valign="true"><![CDATA[Score:]]></txt_game_Score>
		
		<!-- Regular win kudos (no stick earned) -->
		<kudosHeader1><![CDATA[Awesome!]]></kudosHeader1>
		<kudosHeader2><![CDATA[Great Job!]]></kudosHeader2>
		<kudosHeader3><![CDATA[Congrats!]]></kudosHeader3>		
		<kudosCopy1><![CDATA[You helped little sis make it to the potty in time!]]></kudosCopy1>
		<kudosCopy2><![CDATA[No accidents!]]></kudosCopy2>
		<kudosCopy3><![CDATA[You're a super babysitter!]]></kudosCopy3>
		
		<!-- Lost game kudos -->
		<!-- <oopsKudosHeader1><![CDATA[Oops!]]></oopsKudosHeader1> -->
		<oopsKudosHeader1><![CDATA[Don't give up!]]></oopsKudosHeader1>
		<oopsKudosHeader2><![CDATA[Try Again!]]></oopsKudosHeader2>
		<oopsKudosHeader3><![CDATA[Don't give up!]]></oopsKudosHeader3>
		<oopsKudosCopy1><![CDATA[Keep practicing to get more potty-training practice!]]></oopsKudosCopy1>
		<oopsKudosCopy2><![CDATA[You'll have little sis potty-trained in no time!]]></oopsKudosCopy2>
		<oopsKudosCopy3><![CDATA[Keep playing to get little sis to the potty in time!]]></oopsKudosCopy3>
		
		<!-- Sticker earned win kudos -->
		<stickerKudosHeader1><![CDATA[Awesome!]]></stickerKudosHeader1>
		<stickerKudosHeader2><![CDATA[Great Job!]]></stickerKudosHeader2>
		<stickerKudosHeader3><![CDATA[Congrats!]]></stickerKudosHeader3>		
		<stickerKudosCopy1><![CDATA[You helped little sis make it to the potty in time! You earned a perfect potty sticker!]]></stickerKudosCopy1>
		<stickerKudosCopy2><![CDATA[No accidents! You earned a perfect potty sticker!]]></stickerKudosCopy2>
		<stickerKudosCopy3><![CDATA[You're a super babysitter! You earned a perfect potty sticker!]]></stickerKudosCopy3>		
		
		<playAgainCopy><![CDATA[Play again to beat your best score or choose a new floor!]]></playAgainCopy>
		<scoreFinal><![CDATA[Final score:]]></scoreFinal>
		<bestTimeFinal><![CDATA[Best time: ]]></bestTimeFinal>
		
		<firstFloor><![CDATA[1st floor]]></firstFloor>
		<secondFloor><![CDATA[2nd floor]]></secondFloor>
		<thirdFloor><![CDATA[3rd floor]]></thirdFloor>
		
		<ready><![CDATA[Ready?]]></ready>
		<set><![CDATA[Set?]]></set>
		<go><![CDATA[Go!]]></go>
		
		<helpHeader><![CDATA[How to play!]]></helpHeader>
		<helpDescription><![CDATA[Help little sis get to the potty before she has an accident!]]></helpDescription>
		<helpCopy1><![CDATA[Click to open the kid gates for little sis.]]></helpCopy1>
		<helpCopy2><![CDATA[Click the toys to move them out of her way.]]></helpCopy2>
		<helpCopy3><![CDATA[Collect Toilet Paper so little sis will get a "Perfect Potty" sticker!]]></helpCopy3>
		<helpCopy4><![CDATA[Click the dog to keep him away from little sis or she will get off track!]]></helpCopy4>
		
		<kellyPottyChart><![CDATA[Little Sis' potty chart]]></kellyPottyChart>
		<hubCopy><![CDATA[Help little sis get to the potty before she has an accident!]]></hubCopy>
		<hubInstructions><![CDATA[Choose a level to play:]]></hubInstructions>
		<perfectPotty><![CDATA[PERFECT<br>POTTY</br>]]></perfectPotty>
		
		<introInstructions><![CDATA[Hey, babysitter! Can you help potty-train little sis? Get her to the bathroom before she has an accident!]]></introInstructions>
		
		<btnHelp><![CDATA[?]]></btnHelp>
		<btnPlayLarge><![CDATA[play]]></btnPlayLarge>
		<btnReplay valign="true"><![CDATA[replay]]></btnReplay>
		<btnSkip><![CDATA[skip]]></btnSkip>
		<btnPlay><![CDATA[play]]></btnPlay>		
		
		<txt_clickHere><![CDATA[Got a code?]]></txt_clickHere>
		<txt_codeWidgetCTA valign="true"><![CDATA[Codes unlock cool stuff in games!]]></txt_codeWidgetCTA>
		<txt_goBtn><![CDATA[go]]></txt_goBtn>
	</localization>
	
