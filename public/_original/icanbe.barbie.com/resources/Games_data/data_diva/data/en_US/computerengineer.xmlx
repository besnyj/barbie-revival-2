<?xml version="1.0" encoding="utf-8"?>
<data>
	<!--locked>true</locked-->
	<styleSheet>/styles/latin.css</styleSheet>
	<fontSwf>/library/fontLibrary_latin.swf</fontSwf>
	<locked>false</locked>
	
	<isInternational>false</isInternational>
	<printable>/printable/CE_laptopStickers_enUS.pdf</printable>
	
	<localization>
		<!--missing-->
		<replayBtn valign="true"><![CDATA[Play Again]]></replayBtn>
		<nextBtn valign="true"><![CDATA[Next]]></nextBtn>
		
		<unlock_tooltip><![CDATA[Enter your code to unlock this!]]></unlock_tooltip>
		<logo2><![CDATA[Data]]></logo2>
		<logo1><![CDATA[Diva]]></logo1>
		<splashCopy valign="true"><![CDATA[You can be a computer engineer! Help Barbie™ program a robot puppy to do cute tricks!]]></splashCopy>
		<playBtn valign="true"><![CDATA[play]]></playBtn>
		<printBtn valign="true"><![CDATA[print]]></printBtn>
		<hubCopy><![CDATA[Use sticker paper to print out your own stickers. 
Decorate your computer, locker, notebook, and more!]]></hubCopy>
		<goBtn valign="true"><![CDATA[go]]></goBtn>
		<codeWidgetCTA><![CDATA[Codes unlock cool stuff in games!]]></codeWidgetCTA>
		<clickHere><![CDATA[Got a code?]]></clickHere>
		<helpBtn valign="true"><![CDATA[?]]></helpBtn>
		<help2><![CDATA[Watch out for locks. They keep the rows in one place.]]></help2>
		<help1><![CDATA[Use your mouse to drag color blocks left, right, up, or down. Try to match 3 or more of the same color! (Hint: hit "shuffle" if you get stuck.)]]></help1>
		<help3><![CDATA[Look for treats! They help you make matches and keep your puppy happy.]]></help3>
		<help4><![CDATA[Match 4 blocks or more to create a super block -- and see a surprise!]]></help4>
		<helpDescription><![CDATA[Computer engineers use a special language called "code" to make programs work.  
Match blocks of code to make your puppy do tricks!]]></helpDescription>
		<helpHeader><![CDATA[How to play!]]></helpHeader>
		<helpAwardsHeader><![CDATA[Earn Awards!]]></helpAwardsHeader>
		<helpAwardDesc1><![CDATA[Type in the code on the package to unlock the laptop and stickers!]]></helpAwardDesc1>
		<helpAwardDesc2><![CDATA[Match 3 treat codes to get the doggy bone.]]></helpAwardDesc2>
		<helpAwardDesc3><![CDATA[Earn more than 20,000 points to unlock<br>the mouse!]]></helpAwardDesc3>
		<helpAwardDesc4><![CDATA[Create more than 15 super blocks to unlock pink glasses!]]></helpAwardDesc4>
		<helpAward1><![CDATA[LAPTOP]]></helpAward1>
		<helpAward2><![CDATA[BONE]]></helpAward2>
		<helpAward3><![CDATA[MOUSE]]></helpAward3>
		<helpAward4><![CDATA[GLASSES]]></helpAward4>
		<shuffleBtn valign="true"><![CDATA[SHUFFLE]]></shuffleBtn>
		<score><![CDATA[Score]]></score>
		
		<ready><![CDATA[Ready]]></ready>
		<set><![CDATA[Set]]></set>
		<go><![CDATA[GO!]]></go>
		
		<score_match><![CDATA[MATCH x]]></score_match>
		<score_combo><![CDATA[COMBO x]]></score_combo>
		<score_chain><![CDATA[CHAIN x]]></score_chain>
		<score_no_matches><![CDATA[OH NO!<br/>NO POSSIBLE<br/>MATCHES!]]></score_no_matches>
		<score_try_shuffle><![CDATA[TRY<br/>SHUFFLING]]></score_try_shuffle>
	
	</localization>
	
	<endScreen>
		<item score="20000">
			<head><![CDATA[Awesome job!]]></head>
			<body><![CDATA[You get an A+ for creating super-cool computer code!]]></body>
		</item>
		<item score="10000">
			<head><![CDATA[Wow!]]></head>
			<body><![CDATA[You created terrific tricks for your robot dog!]]></body>
		</item>
		<item score="0">
			<head><![CDATA[Way to go!]]></head>
			<body><![CDATA[Keep practicing to match more blocks of programming code!]]></body>
		</item>
	</endScreen>
	
