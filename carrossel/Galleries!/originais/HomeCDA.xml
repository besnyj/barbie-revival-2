<?xml version="1.0"?>
<!--
Author  - Nitin Gore.
Perpose - This file is used for loading swf and tracking user clicks from CDA. 

About the tags in XML :-
<numberOfButtons>			-	Defines the number of active CDA thumbnails.
<showDefaultScreen>			-	You can show some default screen ("defaultScreen_mc") before CDA starts running. 
								This screen will be shown only one time, once CDA starts running/user clicks on some 
								CDA thumbnail this screen will not be shown. [ Values are -> 'yes', 'no']
<firstChosenIndex>			-	CDA of this index will be shown selected by default (Indexing starts from 1). By default first CDA will be shown.

<trackingName>				-	Name used for the Google/Mattel tracking
<trackingCampaign>			-	campaign used for the Google/Mattel tracking
<trackingChannel>			-	channel used for the Google/Mattel tracking
<trackingContenttype>		-	contenttype used for the Google/Mattel tracking
<trackingAction>			-	action used for the Google/Mattel tracking
<filePath>					-	Define CDA swf path to load.
<autoSelectTime>			-	Time for which this CDA will be displayed. Time is in seconds. 
-->
 
<homeCDAs>

	<numberOfButtons>5</numberOfButtons>
	<showDefaultScreen>yes</showDefaultScreen>
	<firstChosenIndex>1</firstChosenIndex>
	<thumbnailFilePath><![CDATA[ThumbnailButtons.swf]]></thumbnailFilePath>
		
	<cda>  <!-- # 1 for now -->
		<trackingName><![CDATA[Dreamhouse Puzzle-Party – from Homepage CDA]]></trackingName>
		<trackingCampaign><![CDATA[None]]></trackingCampaign>
		<trackingChannel><![CDATA[Home]]></trackingChannel>
		<trackingContenttype><![CDATA[cda]]></trackingContenttype>
		<trackingAction><![CDATA[Click]]></trackingAction>
		<filePath><![CDATA[/global/homepageCDARotation/DreamhousePuzzleParty.swf]]></filePath>
		<autoSelectTime>10</autoSelectTime>
		<clickURL><![CDATA[http://dreamhouse.barbie.com/en-US/games/puzzle-party/]]></clickURL>
		<openInSameWindow>yes</openInSameWindow>
		<eventID><![CDATA[Home:P1 BLID Puzzle Game]]></eventID>
